<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                        Akses ditolak. Anda tidak memiliki hak untuk membuka halaman ini.
                    </MudAlert>
                }
            </NotAuthorized>
            <Authorizing>
                <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-4" />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <PageTitle>Halaman tidak ditemukan - SIA</PageTitle>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
                Halaman tidak ditemukan atau belum tersedia.
            </MudAlert>
        </LayoutView>
    </NotFound>
</Router>
