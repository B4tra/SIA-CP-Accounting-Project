@inherits LayoutComponentBase
@using SIA.Web.Theme
@using SIA.Application.Common.Constants

<MudThemeProvider Theme="SiaTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true" Style="background-color: var(--sia-black-primary); color: var(--sia-white);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.BatteryChargingFull" Class="ml-2 mr-2" Style="color: var(--sia-green-accent);" />
        <MudText Typo="Typo.h6" Class="font-weight-bold" Style="color: var(--sia-white);">
            SIA Toko Aki
        </MudText>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.body2" Style="color: var(--sia-white);" Class="d-none d-sm-flex">
                        @context.User.Identity?.Name
                    </MudText>

                    @if (context.User.IsInRole(Roles.Admin))
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color: var(--sia-black-primary); color: var(--sia-green-accent); border: 1px solid var(--sia-green-accent);">
                            Admin
                        </MudChip>
                    }
                    else if (context.User.IsInRole(Roles.Staff))
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color: var(--sia-green-accent); color: var(--sia-black-primary);">
                            Staff
                        </MudChip>
                    }
                    else if (context.User.IsInRole(Roles.Viewer))
                    {
                        <MudChip T="string" Size="Size.Small" Style="background-color: var(--sia-green-action); color: var(--sia-black-primary);">
                            Viewer
                        </MudChip>
                    }

                    <form method="post" action="/api/auth/logout" class="d-inline">
                        <AntiforgeryToken />
                        <button type="submit"
                                class="mud-button-root mud-button mud-button-outlined mud-button-outlined-inherit py-1 px-3"
                                style="color: var(--sia-white); border-color: rgba(255,255,255,0.4); border-radius: 4px; background: transparent; cursor: pointer; font-size: 0.8125rem;">
                            Keluar
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Style="background-color: var(--sia-green-action); color: var(--sia-black-primary);" Href="/login" Size="Size.Small">
                    Masuk
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Style="background-color: var(--sia-black-primary);">
        <MudDrawerHeader Class="pa-4">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color: var(--sia-green-accent);" />
                <div>
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: var(--sia-white);">
                        Menu Utama
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--sia-green-accent);">
                        Sistem Akuntansi
                    </MudText>
                </div>
            </div>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4" Style="background-color: var(--sia-green-bg); min-height: 100vh;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    Terjadi kesalahan sistem yang tidak tertangani.
    <a href="" class="reload">Muat ulang</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
