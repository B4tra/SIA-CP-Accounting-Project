@page "/reports/cash-flow"
@attribute [Authorize(Policy = Policies.ViewReports)]
@using SIA.Application.DTOs.Reporting
@using SIA.Application.Services.Reporting
@inject IFinancialReportService FinancialReportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Laporan Arus Kas - SIA</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between gap-2 no-print">
    <div>
        <h1 class="sia-page-title">Laporan Arus Kas</h1>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Mutasi kas dari aktivitas operasi, investasi, dan pendanaan serta saldo akhir kas.
        </MudText>
    </div>
    <div class="d-flex flex-wrap align-center gap-3">
        <MudDatePicker Label="Dari tanggal" Date="_dateFrom" DateChanged="OnDateFromChanged"
                       DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px" />
        <MudDatePicker Label="Sampai tanggal" Date="_dateTo" DateChanged="OnDateToChanged"
                       DateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:170px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync" Disabled="_loading">Tampilkan</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print"
                   OnClick="PrintAsync" Disabled="@(_data is null)">Cetak Laporan</MudButton>
    </div>
</div>

@if (_loading)
{
    <MudPaper Outlined="true" Class="sia-card pa-6 mt-4">
        <MudText Typo="Typo.body2">Memuat laporan arus kas...</MudText>
    </MudPaper>
}
else if (_data is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
        @(_errorMessage ?? "Gagal memuat data arus kas. Silakan coba kembali.")
    </MudAlert>
}
else
{
    <MudPaper Outlined="true" Class="sia-card pa-6 mt-4 print-container">
        <div class="d-flex flex-wrap justify-space-between align-start gap-4 mb-4">
            <div>
                <MudText Typo="Typo.h6"><strong>TOKO AKI / BATERAI KENDARAAN</strong></MudText>
                <MudText Typo="Typo.subtitle1"><strong>LAPORAN ARUS KAS (CASH FLOW STATEMENT)</strong></MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Periode: @Display.Date(_data.DateFrom) s.d. @Display.Date(_data.DateTo)
                </MudText>
            </div>
            <div style="text-align:right">
                <MudChip T="string" Color="@(_data.NetCashChange >= 0 ? Color.Success : Color.Error)" Variant="Variant.Filled">
                    @(_data.NetCashChange >= 0 ? "Surplus Kas" : "Defisit Kas")
                </MudChip>
            </div>
        </div>

        <MudDivider Class="my-4" />

        <!-- 1. SALDO KAS AWAL -->
        <div class="d-flex justify-space-between align-center pa-3 mb-4" style="background-color: var(--mud-palette-background-gray); border-radius: var(--mud-default-borderradius);">
            <MudText Typo="Typo.subtitle1"><strong>SALDO KAS & SETARA KAS AWAL</strong></MudText>
            <MudText Typo="Typo.subtitle1"><strong>@Display.Rupiah(_data.OpeningCash)</strong></MudText>
        </div>

        <!-- 2. AKTIVITAS OPERASI -->
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2"><strong>1. ARUS KAS DARI AKTIVITAS OPERASI</strong></MudText>
        <MudSimpleTable Dense="true" Bordered="false" Class="sia-table mb-2">
            <tbody>
                @if (_data.OperatingActivities.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="mud-text-secondary" style="font-style:italic">Tidak ada transaksi aktivitas operasi</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in _data.OperatingActivities.Lines)
                    {
                        <tr>
                            <td>@line.AccountCode - @line.AccountName</td>
                            <td style="text-align:right">@Display.Rupiah(line.Amount)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:bold; background-color: var(--mud-palette-background-gray);">
                    <td>Arus Kas Bersih dari Aktivitas Operasi</td>
                    <td style="text-align:right">@Display.Rupiah(_data.OperatingActivities.Total)</td>
                </tr>
            </tfoot>
        </MudSimpleTable>

        <!-- 3. AKTIVITAS INVESTASI -->
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2"><strong>2. ARUS KAS DARI AKTIVITAS INVESTASI</strong></MudText>
        <MudSimpleTable Dense="true" Bordered="false" Class="sia-table mb-2">
            <tbody>
                @if (_data.InvestingActivities.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="mud-text-secondary" style="font-style:italic">Tidak ada transaksi aktivitas investasi</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in _data.InvestingActivities.Lines)
                    {
                        <tr>
                            <td>@line.AccountCode - @line.AccountName</td>
                            <td style="text-align:right">@Display.Rupiah(line.Amount)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:bold; background-color: var(--mud-palette-background-gray);">
                    <td>Arus Kas Bersih dari Aktivitas Investasi</td>
                    <td style="text-align:right">@Display.Rupiah(_data.InvestingActivities.Total)</td>
                </tr>
            </tfoot>
        </MudSimpleTable>

        <!-- 4. AKTIVITAS PENDANAAN -->
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2"><strong>3. ARUS KAS DARI AKTIVITAS PENDANAAN</strong></MudText>
        <MudSimpleTable Dense="true" Bordered="false" Class="sia-table mb-2">
            <tbody>
                @if (_data.FinancingActivities.Lines.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="mud-text-secondary" style="font-style:italic">Tidak ada transaksi aktivitas pendanaan</td>
                    </tr>
                }
                else
                {
                    @foreach (var line in _data.FinancingActivities.Lines)
                    {
                        <tr>
                            <td>@line.AccountCode - @line.AccountName</td>
                            <td style="text-align:right">@Display.Rupiah(line.Amount)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:bold; background-color: var(--mud-palette-background-gray);">
                    <td>Arus Kas Bersih dari Aktivitas Pendanaan</td>
                    <td style="text-align:right">@Display.Rupiah(_data.FinancingActivities.Total)</td>
                </tr>
            </tfoot>
        </MudSimpleTable>

        <!-- 5. KENAIKAN / PENURUNAN BERSIH KAS -->
        <div class="d-flex justify-space-between align-center pa-3 my-3" style="background-color: var(--mud-palette-background-gray); border-radius: var(--mud-default-borderradius);">
            <MudText Typo="Typo.subtitle1"><strong>KENAIKAN / (PENURUNAN) BERSIH KAS</strong></MudText>
            <MudText Typo="Typo.h6"><strong>@Display.Rupiah(_data.NetCashChange)</strong></MudText>
        </div>

        <!-- 6. SALDO KAS AKHIR -->
        <div class="d-flex justify-space-between align-center pa-4 mt-6" style="background-color: var(--mud-palette-background-gray); border-radius: var(--mud-default-borderradius); border: 2px solid var(--mud-palette-primary);">
            <div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">POSISI KAS AKHIR</MudText>
                <MudText Typo="Typo.h6"><strong>SALDO KAS & SETARA KAS AKHIR</strong></MudText>
            </div>
            <MudText Typo="Typo.h5">
                <strong>@Display.Rupiah(_data.ClosingCash)</strong>
            </MudText>
        </div>
    </MudPaper>
}

@code {
    private DateTime? _dateFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _dateTo = DateTime.Today;
    private CashFlowDto? _data;
    private string? _errorMessage;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void OnDateFromChanged(DateTime? date)
    {
        _dateFrom = date;
    }

    private void OnDateToChanged(DateTime? date)
    {
        _dateTo = date;
    }

    private async Task LoadAsync()
    {
        if (_dateFrom.HasValue && _dateTo.HasValue && _dateFrom.Value.Date > _dateTo.Value.Date)
        {
            Snackbar.Add("Tanggal awal tidak boleh melebihi tanggal akhir.", Severity.Warning);
            return;
        }

        _loading = true;
        _errorMessage = null;

        var from = _dateFrom ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var to = _dateTo ?? DateTime.Today;

        var result = await FinancialReportService.GetCashFlowAsync(from, to);
        if (result.IsSuccess)
        {
            _data = result.Value;
        }
        else
        {
            _data = null;
            _errorMessage = result.Error;
            Snackbar.Add(result.Error!, Severity.Error);
        }

        _loading = false;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");
}
