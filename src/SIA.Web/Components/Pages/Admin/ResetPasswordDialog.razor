@using SIA.Application.DTOs.System
@using SIA.Application.Services.System
@inject IUserService UserService

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                Atur ulang kata sandi untuk pengguna <strong>@FullName</strong> (@UserName). Sesi login pengguna akan ditutup otomatis.
            </MudAlert>

            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                    @foreach (var error in _errors)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }

            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.NewPassword" For="@(() => Model.NewPassword)"
                                  InputType="InputType.Password" Label="Kata sandi baru" Variant="Variant.Outlined" Required="true"
                                  HelperText="Minimal 8 karakter (huruf besar, huruf kecil, angka)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.ConfirmPassword" For="@(() => Model.ConfirmPassword)"
                                  InputType="InputType.Password" Label="Konfirmasi kata sandi baru" Variant="Variant.Outlined" Required="true" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_saving">Batal</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                @(_saving ? "Menyimpan..." : "Reset Kata Sandi")
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string FullName { get; set; } = string.Empty;

    private ResetUserPasswordDto Model { get; set; } = new();
    private List<string> _errors = new();
    private bool _saving;

    protected override void OnInitialized()
    {
        Model.Id = UserId;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _errors.Clear();

        var result = await UserService.ResetPasswordAsync(Model);
        _saving = false;

        if (result.IsSuccess)
            MudDialog.Close(DialogResult.Ok(true));
        else
            _errors = result.Errors.ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
