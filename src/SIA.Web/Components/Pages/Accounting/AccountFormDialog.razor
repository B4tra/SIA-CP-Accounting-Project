@using SIA.Application.DTOs.Accounting
@using SIA.Application.Services.Accounting
@inject IAccountService AccountService

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                    @foreach (var error in _errors)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="Model.Code" For="@(() => Model.Code)" Label="Kode akun" Placeholder="mis. 1-1001" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Label="Nama akun" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudSelect T="AccountCategory" @bind-Value="Model.Category" Label="Kategori" Variant="Variant.Outlined">
                        @foreach (var category in Enum.GetValues<AccountCategory>())
                        {
                            <MudSelectItem T="AccountCategory" Value="@category">@Display.Label(category)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="NormalBalance" @bind-Value="Model.NormalBalance" Label="Saldo normal" Variant="Variant.Outlined">
                        @foreach (var nb in Enum.GetValues<NormalBalance>())
                        {
                            <MudSelectItem T="NormalBalance" Value="@nb">@Display.Label(nb)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int?" @bind-Value="Model.ParentAccountId" Label="Akun induk (opsional)" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var parent in ParentOptions)
                        {
                            <MudSelectItem T="int?" Value="@parent.Id">@parent.Code - @parent.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Description" For="@(() => Model.Description)" Label="Deskripsi" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
                @if (Model is UpdateAccountDto update)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="update.IsActive" Color="Color.Secondary" Label="Akun aktif" />
                    </MudItem>
                }
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel" Disabled="_saving">Batal</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                @(_saving ? "Menyimpan..." : "Simpan")
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Instance <see cref="UpdateAccountDto"/> berarti mode ubah; selain itu mode tambah.</summary>
    [Parameter] public CreateAccountDto Model { get; set; } = new();

    /// <summary>Pilihan akun induk (tanpa akun yang sedang diubah).</summary>
    [Parameter] public IReadOnlyList<AccountDto> ParentOptions { get; set; } = Array.Empty<AccountDto>();

    private List<string> _errors = new();
    private bool _saving;

    private async Task SubmitAsync()
    {
        _saving = true;
        _errors.Clear();

        var result = Model is UpdateAccountDto update
            ? await AccountService.UpdateAsync(update)
            : await AccountService.CreateAsync(Model);

        _saving = false;
        if (result.IsSuccess)
            MudDialog.Close(DialogResult.Ok(result.Value));
        else
            _errors = result.Errors.ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
